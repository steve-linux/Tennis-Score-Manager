# Ogni 5 minuti: se il provider cambia l'indirizzo di casa, il nome del circolo lo segue.
[Unit]
Description=TSM club server: update the DuckDNS address every 5 minutes

[Timer]
OnBootSec=30
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
